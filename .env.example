# ==============================================================================
# ArchMind-Electrical-NodeJS-Agent Environment Configuration
# ==============================================================================

# Application Configuration
NODE_ENV=production
PORT=4000
API_PREFIX=api

# MQTT Broker Configuration
MQTT_BROKER_URL=mqtts://localhost:8883
MQTT_CLIENT_ID=archmind-backend-ingest
MQTT_USERNAME=archmind_backend
MQTT_PASSWORD=replace_with_secure_broker_password
MQTT_TOPIC_TELEMETRY=devices/+/telemetry
MQTT_TOPIC_COMMANDS=devices/+/commands
MQTT_CA_CERT_PATH=/etc/ssl/certs/mqtt-ca.crt
MQTT_CLIENT_CERT_PATH=/etc/ssl/certs/client.crt
MQTT_CLIENT_KEY_PATH=/etc/ssl/certs/client.key
MQTT_REJECT_UNAUTHORIZED=true

# PostgreSQL Relational Metadata Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=archmind_user
POSTGRES_PASSWORD=replace_with_secure_pg_password
POSTGRES_DB=archmind_db
POSTGRES_SSL=false

# InfluxDB Time-Series Telemetry Database
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=replace_with_secure_influx_token
INFLUXDB_ORG=archmind_org
INFLUXDB_BUCKET=archmind_telemetry

# Redis Distributed Cache & Pub/Sub
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Security & Authentication
API_KEY=replace_with_random_32_byte_secret_key
JWT_SECRET=replace_with_jwt_hmac_secret_key
CORS_ORIGIN=http://localhost:3000

# Next.js Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=http://localhost:4000
