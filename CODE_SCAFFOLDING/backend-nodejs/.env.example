PORT=4000
NODE_ENV=development
API_KEY=archmind_dev_api_key_secret_2026
CORS_ORIGIN=*

# MQTT
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_CLIENT_ID=archmind-dev-backend
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_TELEMETRY=devices/+/telemetry

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=archmind_db

# InfluxDB
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=dev_token
INFLUXDB_ORG=archmind
INFLUXDB_BUCKET=telemetry
